OPENROUTER_API_KEY=
GAMMA_API_KEY=

# Gemma does the work, explains it, and listens to the human.
AGENT_MODEL=google/gemma-4-31b-it
NARRATOR_MODEL=google/gemma-4-26b-a4b-it
STEER_MODEL=google/gemma-4-26b-a4b-it

# Open-weight checkers from three different labs: Google, OpenAI (gpt-oss), Mistral.
CHECKER_MODELS=google/gemma-4-31b-it,openai/gpt-oss-120b,mistralai/mistral-small-2603

# Backups OpenRouter tries if the requested model fails.
FALLBACK_MODELS=google/gemma-4-26b-a4b-it,mistralai/mistral-small-2603

GATE_CONFIDENCE=0.6
WEB_SEARCH=1

# Set MOCK_MODE=1 to run with fake replies (no key needed).
MOCK_MODE=0

# Demo fallback: narrator asks a small-context model first, so it fails for a real reason.
DEMO_FALLBACK=0
DEMO_FALLBACK_PRIMARY=
DEMO_FALLBACK_CONTEXT=8192
